FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      Laser_boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    back
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    front
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    leftWall
    {
        type            fixedValue;
        value           uniform -1;
    }
    rightWall
    {
        type            fixedValue;
        value           uniform -1;
    }
    topWall
    {
        type            fixedValue;
        value           uniform 1;
    }
    bottomWall
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary1to2
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary1to4
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary1to5
    {
        type            processor;
        value           uniform 0;
    }
}


