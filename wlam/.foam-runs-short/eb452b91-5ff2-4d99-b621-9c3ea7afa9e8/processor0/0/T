FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    inletSubstrate
    {
        type            fixedValue;
        value           uniform 300;
    }
    inletGas
    {
        type            fixedValue;
        value           uniform 300;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    top
    {
        type            inletOutlet;
        inletValue      uniform 300;
        value           uniform 300;
    }
    symmetry
    {
        type            symmetryPlane;
    }
    side
    {
        type            zeroGradient;
    }
    wireInlet
    {
        type            fixedValue;
        value           uniform 300;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 300;
    }
}


